# ==============================================================================
# DNORA Luxury Atelier — Environment Configuration Template
# Copy this file to .env.local and set your secure environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL Pooler / Direct)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URI (e.g., Supabase transaction pooler or direct connection)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Optional / Client OAuth & Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Sessions
# ------------------------------------------------------------------------------
# High-entropy secret key used for HMAC-SHA256 session token signatures (minimum 32 characters)
SESSION_SECRET=your_super_secret_high_entropy_signing_key_min_32_chars

# Master Administrative Security Key (used for /admin/login authentication)
ADMIN_PASSWORD=your_strong_admin_management_password_here
ADMIN_EMAIL=admin@dnora.luxury

# ------------------------------------------------------------------------------
# 4. Cloudinary Media Storage (Images & Videos)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000
